# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Required: your Anthropic API key
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: port for the Flask server (default 5050)
PORT=5050

# Optional: allowed origins for CORS (comma-separated)
# In production, set this to your frontend's actual domain
# ALLOWED_ORIGINS=https://your-org.github.io,https://yourapp.com
